# Dictionary for the fuzz targets that read whole HEIC/HEIF/AVIF files
# (heic, container, diff). libFuzzer: -dict=, AFL++: -x.
# Box types, brands, item and reference types the parser compares against,
# plus the strings and size patterns that are hard to produce by bit flips.

# --- top level and meta ---
"ftyp"
"meta"
"mdat"
"moov"
"mini"
"hdlr"
"pitm"
"iloc"
"iinf"
"infe"
"iref"
"iprp"
"ipco"
"ipma"
"idat"
"dinf"
"grpl"

# --- item properties ---
"ispe"
"pixi"
"colr"
"clap"
"irot"
"imir"
"auxC"
"hvcC"
"av1C"
"uncC"
"cmpd"
"cmpC"
"icef"
"rref"
"a1op"
"a1lx"

# --- item types ---
"hvc1"
"hev1"
"av01"
"unci"
"grid"
"iovl"
"iden"
"tmap"
"Exif"
"mime"
"hvcB"

# --- item references ---
"dimg"
"thmb"
"auxl"
"cdsc"
"pred"
"auxi"

# --- sequences (moov) ---
"mvhd"
"trak"
"tkhd"
"tref"
"edts"
"elst"
"mdia"
"mdhd"
"minf"
"stbl"
"stsd"
"stts"
"ctts"
"stsc"
"stsz"
"stco"
"co64"
"stss"
"pict"
"vide"
"auxv"

# --- brands ---
"heic"
"heix"
"hevc"
"hevx"
"mif1"
"mif2"
"mif3"
"msf1"
"avif"
"avis"

# --- colr types, unci compression ---
"nclx"
"prof"
"ricc"
"defl"
"zlib"
"brot"

# --- strings ---
"urn:mpeg:hevc:2015:auxid:1"
"urn:mpeg:mpegB:cicp:systems:auxiliary:alpha"
"urn:com:apple:photo:2020:aux:hdrgainmap"
"application/rdf+xml"
"MM\x00*"
"II*\x00"
"Exif\x00\x00"

# --- sizes and counts ---
# largesize marker, "to end of file", and a few box sizes
"\x00\x00\x00\x01"
"\x00\x00\x00\x00"
"\x00\x00\x00\x08"
"\x00\x00\x00\x0c"
"\x00\x00\x00\x10"
"\xff\xff\xff\xff"
"\x7f\xff\xff\xff"
"\x80\x00\x00\x00"
"\xff\xff"
# FullBox version 1 / 2 with zero flags
"\x01\x00\x00\x00"
"\x02\x00\x00\x00"
# iloc: 4-byte offset and length, no base offset; 8-byte variants
"\x44\x00"
"\x44\x40"
"\x88\x80"
# essential property association (index 1, 2)
"\x81"
"\x82"
"\x80\x01"
# HEVC NAL headers that follow a 4-byte length in item data
"\x40\x01"
"\x42\x01"
"\x44\x01"
"\x26\x01"
"\x28\x01"
"\x02\x01"
