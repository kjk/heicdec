# Dictionary for the "hevc" fuzz target (raw Annex B streams).
# libFuzzer: -dict=, AFL++: -x.

# --- start codes and emulation prevention ---
"\x00\x00\x01"
"\x00\x00\x00\x01"
"\x00\x00\x03"

# --- start code + NAL header (nal_unit_type << 1, layer 0, temporal id 0) ---
# TRAIL_N, TRAIL_R, TSA_N, TSA_R, STSA_N, STSA_R
"\x00\x00\x01\x00\x01"
"\x00\x00\x01\x02\x01"
"\x00\x00\x01\x04\x01"
"\x00\x00\x01\x06\x01"
"\x00\x00\x01\x08\x01"
"\x00\x00\x01\x0a\x01"
# RADL_N, RADL_R, RASL_N, RASL_R
"\x00\x00\x01\x0c\x01"
"\x00\x00\x01\x0e\x01"
"\x00\x00\x01\x10\x01"
"\x00\x00\x01\x12\x01"
# BLA_W_LP, BLA_W_RADL, BLA_N_LP, IDR_W_RADL, IDR_N_LP, CRA
"\x00\x00\x01\x20\x01"
"\x00\x00\x01\x22\x01"
"\x00\x00\x01\x24\x01"
"\x00\x00\x01\x26\x01"
"\x00\x00\x01\x28\x01"
"\x00\x00\x01\x2a\x01"
# VPS, SPS, PPS, AUD, EOS, EOB, prefix SEI, suffix SEI
"\x00\x00\x01\x40\x01"
"\x00\x00\x01\x42\x01"
"\x00\x00\x01\x44\x01"
"\x00\x00\x01\x46\x01"
"\x00\x00\x01\x48\x01"
"\x00\x00\x01\x4a\x01"
"\x00\x00\x01\x4e\x01"
"\x00\x00\x01\x50\x01"

# --- NAL headers alone, and with other temporal / layer ids ---
"\x40\x01"
"\x42\x01"
"\x44\x01"
"\x26\x01"
"\x02\x01"
"\x02\x02"
"\x02\x03"
"\x02\x09"

# --- first bytes of a slice header ---
# first_slice_segment_in_pic_flag set / clear with small Exp-Golomb codes
"\x80"
"\xa0"
"\xc0"
"\x40"
"\x20"

# --- bit patterns the entropy decoders treat specially ---
"\xff\xff"
"\xff\xff\xff\xff"
"\x00\x00\x00\x00"
"\x7f"
"\xfe"
